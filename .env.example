# ─────────────────────────────────────────────────────────────
# IMPORTANT: every VITE_* value set in this file is embedded into the
# public JS bundle at build time — anyone can read it in devtools.
# That is how Vite works; a VITE_ variable can never be "hidden".
#
# The canonical place to manage the values below is the BACKEND .env
# (company_profile_BE/.env). They are delivered to this app at runtime
# via GET /api/site-config. You normally do NOT need to set any of them
# here.
#
# The commented lines below exist only as an optional local-override
# reference: uncomment a line to force that value into your local build
# (the backend runtime config still wins for the rest).
# ─────────────────────────────────────────────────────────────

# Required bootstrap values (not secret)
VITE_DEV_PORT=5173
VITE_API_BASE_URL=http://localhost:5000/api

# ── Optional overrides (managed in backend .env by default) ──
# VITE_CONTACT_EMAIL=info@primesoftechs.com
# VITE_CONTACT_MOBILE=+91 70647 02015
# VITE_CAREERS_EMAIL=hr@primesoftechs.com
# VITE_LINKEDIN_URL=https://in.linkedin.com/company/primesoftech
# VITE_INSTAGRAM_URL=https://www.instagram.com/prime_softech/
# VITE_FACEBOOK_URL=https://www.facebook.com/primesoftech67
# VITE_OFFICE_NAME=Prime Softech
# VITE_OFFICE_LOCATION=Surat, Gujarat, India
# VITE_OFFICE_ADDRESS=901/905 TFC - The Future Corner, Near 300 Feet Ring Road Touch,Sarthana JakatNaka - Surat, Gujarat 395013
# VITE_OFFICE_TIMEZONE=India Standard Time · UTC+5:30
# VITE_OFFICE_HOURS=Monday to Saturday: 10:00am - 7:00pm
# VITE_MAP_EMBED_URL=https://maps.google.com/maps?q=...&output=embed
# VITE_MAP_DIRECTIONS_URL=https://maps.app.goo.gl/...

# ── Hero animations (public lottie.host URLs, backend-managed by default) ──
# VITE_HOME_LOTTIE_URL=
# VITE_CAREER_LOTTIE_URL=
# VITE_CONTACT_LOTTIE_URL=
# VITE_ABOUT_LOTTIE_URL=
